{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamesense.dev/schemas/model-execution-request.schema.json",
  "title": "ModelExecutionRequest",
  "description": "One model invocation against an immutable data snapshot. Configuration is the only extensible payload object and must also pass the selected model configuration schema.",
  "type": "object",
  "properties": {
    "executionId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "modelId": {
      "$ref": "common.schema.json#/$defs/nonBlankString"
    },
    "matchup": {
      "$ref": "matchup.schema.json"
    },
    "dataSnapshotId": {
      "$ref": "common.schema.json#/$defs/nonBlankString"
    },
    "executionKind": {
      "type": "string",
      "enum": [
        "DETERMINISTIC",
        "STOCHASTIC",
        "SIMULATION"
      ]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": true
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "trials": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    }
  },
  "required": [
    "executionId",
    "modelId",
    "matchup",
    "dataSnapshotId",
    "executionKind"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "executionKind": {
            "const": "SIMULATION"
          }
        },
        "required": [
          "executionKind"
        ]
      },
      "then": {
        "required": [
          "trials"
        ]
      },
      "else": {
        "not": {
          "required": [
            "trials"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "executionKind": {
            "const": "DETERMINISTIC"
          }
        },
        "required": [
          "executionKind"
        ]
      },
      "then": {
        "not": {
          "required": [
            "seed"
          ]
        }
      }
    }
  ]
}
