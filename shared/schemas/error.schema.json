{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamesense.dev/schemas/error.schema.json",
  "title": "ErrorResponse",
  "description": "Consistent safe error structure. Detail paths are JSON Pointers; empty path identifies the root. requestId is optional opaque correlation metadata.",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "VALIDATION_ERROR",
        "NOT_FOUND",
        "UNSUPPORTED_METHOD",
        "PREDICTION_FAILED",
        "INTERNAL_ERROR"
      ]
    },
    "message": {
      "$ref": "common.schema.json#/$defs/nonBlankString"
    },
    "requestId": {
      "$ref": "common.schema.json#/$defs/nonBlankString"
    },
    "details": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(|/.*)$"
          },
          "message": {
            "$ref": "common.schema.json#/$defs/nonBlankString"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "code",
    "message"
  ],
  "additionalProperties": false
}
