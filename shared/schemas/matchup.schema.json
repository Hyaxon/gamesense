{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamesense.dev/schemas/matchup.schema.json",
  "title": "Matchup",
  "description": "Home and away designate consistent sides even at a neutral site. Teams must differ; existence and season availability are semantic checks.",
  "type": "object",
  "properties": {
    "homeTeamId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "awayTeamId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "season": {
      "type": "integer",
      "minimum": 1
    },
    "isNeutralSite": {
      "type": "boolean"
    }
  },
  "required": [
    "homeTeamId",
    "awayTeamId",
    "season",
    "isNeutralSite"
  ],
  "additionalProperties": false
}
